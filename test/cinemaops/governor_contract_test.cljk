(ns cinemaops.governor-contract-test
  "Integration tests: full OperationActor graph exercising the
  governor's hard checks, escalation logic, and audit trail."
  (:require [kotoba.test :refer [deftest is testing]]
            [langgraph.graph :as g]
            [cinemaops.advisor :as advisor]
            [cinemaops.store :as store]
            [cinemaops.operation :as op]))

(defn exec-request [actor tid request ctx]
  (g/run* actor {:request request :context ctx} {:thread-id tid}))

(defn resume-approval [actor tid status]
  (g/run* actor {:approval {:status status :by "coordinator"}} {:thread-id tid :resume? true}))

(deftest screening-record-logging-full-flow
  (testing "clean screening-record proposal -> auto-commit at phase 3"
    (let [db (store/seed-db)
          actor (op/build db)
          ctx {:actor-id "test-1" :phase 3}
          result (exec-request actor "t1"
                               {:op :log-screening-record :screening-id "screening-1" :patch {:attendance 100 :print-quality "clean"}}
                               ctx)]
      (is (some? result))
      (is (> (count (store/ledger db)) 0)
          "commit must append audit facts to ledger")
      (is (> (count (store/coordination-log db)) 0)
          "commit must append record to coordination-log"))))

(deftest patron-safety-concern-always-escalates
  (testing ":flag-patron-safety-concern escalates for human approval, regardless of phase/confidence"
    (let [db (store/seed-db)
          actor (op/build db)
          ctx {:actor-id "test-2" :phase 3}
          result (exec-request actor "t2"
                               {:op :flag-patron-safety-concern :screening-id "screening-1"
                                :patch {:concern "smoke smell reported near exit" :confidence 0.99}}
                               ctx)]
      (is (some? result))
      ;; At this point the actor is paused for approval, not yet committed
      (is (= 0 (count (store/coordination-log db)))
          "patron safety concern must not auto-commit, must wait for approval")
      ;; Now approve it
      (resume-approval actor "t2" :approved)
      (is (> (count (store/coordination-log db)) 0)
          "after approval, record must be committed"))))

(deftest unregistered-screening-hard-hold
  (testing "unregistered screening -> permanent HARD hold, never escalates"
    (let [db (store/seed-db)
          actor (op/build db)
          ctx {:actor-id "test-3" :phase 3}]
      (exec-request actor "t3"
                     {:op :log-screening-record :screening-id "unknown-screening"
                      :patch {:attendance 0}}
                     ctx)
      (is (= 0 (count (store/coordination-log db)))
          "HARD hold must never commit"))))

(deftest unverified-screening-hard-hold
  (testing "registered but unverified screening -> permanent HARD hold"
    (let [db (store/seed-db)
          actor (op/build db)
          ctx {:actor-id "test-4" :phase 3}
          result (exec-request actor "t4"
                               {:op :log-screening-record :screening-id "screening-3"
                                :patch {:attendance 0}}
                               ctx)]
      (is (some? result))
      (is (= 0 (count (store/coordination-log db)))
          "unverified screening must HARD hold"))))

(deftest effect-not-propose-hard-hold
  (testing "proposal with :effect :commit (not :propose) -> hard hold"
    (let [db (store/seed-db)
          bad-advisor (reify advisor/Advisor
                        (-advise [_ _ req]
                          (assoc (advisor/infer nil req) :effect :commit)))
          actor (op/build db {:advisor bad-advisor})
          ctx {:actor-id "test-5" :phase 3}
          result (exec-request actor "t5"
                               {:op :log-screening-record :screening-id "screening-1"
                                :patch {:attendance 50}}
                               ctx)]
      (is (some? result))
      (is (= 0 (count (store/coordination-log db)))
          "non-:propose effect must HARD hold"))))

(deftest scope-excluded-content-hard-hold
  (testing "proposal drifting into evacuation-override/projector-control scope -> permanent hard hold"
    (let [db (store/seed-db)
          actor (op/build db)
          ctx {:actor-id "test-6" :phase 3}
          result (exec-request actor "t6"
                               {:op :log-screening-record :screening-id "screening-1"
                                :out-of-scope? true  ; triggers scope pollution in advisor
                                :patch {}}
                               ctx)]
      (is (some? result))
      (is (= 0 (count (store/coordination-log db)))
          "scope-excluded content must HARD hold"))))

(deftest phase-1-approval-gate
  (testing "phase 1 approved request -> commits after human approval"
    (let [db (store/seed-db)
          actor (op/build db)
          ctx {:actor-id "test-7" :phase 1}]
      (exec-request actor "t7"
                     {:op :log-screening-record :screening-id "screening-1"
                      :patch {:attendance 20}}
                     ctx)
      (is (= 0 (count (store/coordination-log db)))
          "phase 1 must not auto-commit, requires approval")
      (resume-approval actor "t7" :approved)
      (is (> (count (store/coordination-log db)) 0)
          "after approval, must commit")
      (is (some #(= :committed (:t %)) (store/ledger db))
          "committed fact must be logged after approval"))))

(deftest audit-trail-completeness
  (testing "every decision leaves immutable audit facts"
    (let [db (store/seed-db)
          actor (op/build db)
          ctx {:actor-id "test-8" :phase 3}]
      (exec-request actor "t8a"
                     {:op :log-screening-record :screening-id "screening-1" :patch {:attendance 30}}
                     ctx)
      (exec-request actor "t8b"
                     {:op :log-screening-record :screening-id "unknown" :patch {:attendance 30}}
                     ctx)
      (let [ledger (store/ledger db)]
        (is (> (count ledger) 0))
        (is (some #(= :committed (:t %)) ledger)
            "successful commits must be logged")
        (is (some #(= :governor-hold (:t %)) ledger)
            "HARD holds must be logged")))))

(deftest safety-authority-decision-is-never-auto-commit-eligible
  (testing "CRITICAL Wave 4 person-facing-service guardrail: a proposal that directly finalizes a patron-safety-authority decision (evacuation override, age-rating admission override) must never reach :commit at any phase, and flag-patron-safety-concern must never be a member of any phase's :auto set"
    (let [db (store/seed-db)
          poisoned-advisor (reify advisor/Advisor
                              (-advise [_ _ req]
                                (assoc (advisor/infer nil req)
                                       :rationale "override the evacuation order and admit despite the age rating restriction")))
          actor (op/build db {:advisor poisoned-advisor})
          ctx {:actor-id "test-9" :phase 3}
          result (exec-request actor "t9"
                               {:op :log-screening-record :screening-id "screening-1" :patch {:attendance 10}}
                               ctx)]
      (is (some? result))
      (is (= 0 (count (store/coordination-log db)))
          "a patron-safety-authority-finalizing proposal must never commit"))))
